# Add provider credentials here. Keys are read only by the local server.
# Muse Spark is selected when its key is present; otherwise Gemini is used.

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-flash-latest
LLM_EMBEDDING_MODEL=gemini-embedding-001

# Chat provider. meta selects Muse Spark when the fallback key is set.
LLM_PRIMARY=meta

# Chat backup. Embeddings stay on Gemini. Leave the key empty to skip the backup.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.meta.ai/v1
LLM_FALLBACK_MODEL=muse-spark-1.3-contributor

# Voice provider selected when no browser preference has been saved.
VOICE_PROVIDER=vapi

# Vapi uses its public key in the browser only on a public HTTPS deployment.
VAPI_PUBLIC_KEY=
VAPI_VOICE_ID=Jess
VAPI_FIRST_MESSAGE_INTERRUPTIONS=false
VAPI_WAIT_SECONDS=0.4
VAPI_SILENCE_TIMEOUT_SECONDS=45
VAPI_MAX_DURATION_SECONDS=1200

# Shared voice behavior defaults. These are visible and editable in Settings.
VOICE_NOISE_CANCELLATION=true
VOICE_ECHO_CANCELLATION=true
VOICE_NOISE_SUPPRESSION=true
VOICE_AUTO_GAIN_CONTROL=true
VOICE_INTERRUPTION_ENABLED=true
VOICE_INTERRUPTION_MODE=adaptive
VOICE_INTERRUPTION_MIN_DURATION_MS=500
VOICE_INTERRUPTION_MIN_WORDS=0
VOICE_INTERRUPTION_BACKOFF_SECONDS=1
VOICE_ENDPOINTING_MODE=fixed
VOICE_ENDPOINTING_MIN_DELAY_MS=500
VOICE_ENDPOINTING_MAX_DELAY_MS=3000
VOICE_PREEMPTIVE_GENERATION=false
VOICE_AEC_WARMUP_MS=3000

# LiveKit server credentials. The secret stays on the server and is never sent
# to the browser. Set NOVA_APP_URL to the public app URL for a deployed worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=nova-interviewer
LIVEKIT_STT_MODEL=assemblyai/universal-3-5-pro
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
LIVEKIT_TTS_SPEED=1.1
LIVEKIT_TTS_EMOTION=excited
# Optional worker-side enhanced processor module. Browser WebRTC processing is
# always controlled from Settings; leave this blank unless the plugin is installed.
LIVEKIT_NOISE_CANCELLATION_MODULE_ID=
NOVA_APP_URL=
